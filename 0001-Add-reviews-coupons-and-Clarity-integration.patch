+.rating_summary { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.product_rating--reviews { display: block; width: 100%; }
+.review_form { display: grid; gap: 10px; margin-top: 18px; }
+.review_form textarea {
+  width: 100%; min-height: 100px; padding: 14px; resize: vertical;
+  border: 1px solid #dce7ec; border-radius: 12px; font: inherit; box-sizing: border-box;
+}
+.review_form textarea:focus { outline: 2px solid rgba(135, 206, 235, .35); border-color: #87ceeb; }
+.review_form button {
+  justify-self: start; padding: 11px 20px; border: 0; border-radius: 999px;
+  background: #87ceeb; color: white; font-weight: 700; cursor: pointer;
