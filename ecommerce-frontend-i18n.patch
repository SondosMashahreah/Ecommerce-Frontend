 export function localizedCategory(category, language) {
   return localizedProductName(category, language);
 }
+
+// Preferred path for API products created after the bilingual catalog migration.
+// Old products still fall back to the legacy dictionary/term translator above.
+export function localizedProduct(product, language) {
+  if (!product) return product;
+
+  const isArabic = String(language || '').toLowerCase().startsWith('ar');
+
+  return {
+    ...product,
+    name: isArabic
+      ? (product.name_ar || localizedProductName(product.name, 'ar'))
+      : product.name,
+    description: isArabic
+      ? (product.description_ar || localizedProductDescription(product.description, 'ar'))
+      : product.description,
+    category: isArabic
+      ? (product.category_ar || localizedCategory(product.category, 'ar'))
+      : product.category,
+  };
+}
