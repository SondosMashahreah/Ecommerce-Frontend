+:root{--main_color:rgb(135,206,235);--bg_color:#f3f3f3;--white_color:#fff;--color_heading:#253237;--color_h1:#112028;--color_h2:#012d3b;--border_color:#d6d6d6d5}
+.top_header{position:relative;width:100%;background:rgb(200,231,243);border-bottom:1px solid var(--border_color);overflow:visible;z-index:400}
+.top_header .container{width:min(92%,1400px);min-height:82px;margin:auto;display:grid;grid-template-columns:170px minmax(240px,700px) auto;align-items:center;gap:24px}
+.top_header .logo{position:absolute;left:max(4%,calc((100% - 1400px)/2));top:-57px;width:52px;height:52px;display:flex;z-index:2000}
+.top_header .logo img{width:100%;height:100%;object-fit:contain}
+.profile_menu_wrapper{position:relative;min-width:0;z-index:2100}
+.profile_btn{max-width:100%;min-width:0;height:44px;padding:0 14px;display:flex;align-items:center;gap:8px;background:#ffffffb3;border:1px solid #fffffff2;border-radius:12px;color:var(--color_heading);font-size:14px;font-weight:600;cursor:pointer}
+.profile_btn:hover{background:white}.profile_btn svg{flex:none;font-size:22px}.profile_btn span{overflow:hidden;color:var(--color_heading);text-overflow:ellipsis;white-space:nowrap}
+.header_profile_image{width:30px;height:30px;flex:none;border:2px solid white;border-radius:50%;object-fit:cover}
+.profile_sidebar{position:absolute;top:calc(100% + 9px);left:0;width:min(230px,88vw);padding:8px;background:white;border:1px solid var(--border_color);border-radius:12px;box-shadow:0 15px 35px #00000026;opacity:0;visibility:hidden;transform:translateY(-8px);transition:.25s;z-index:2200}
+.profile_sidebar.active{opacity:1;visibility:visible;transform:none}
+.profile_sidebar button{width:100%;padding:12px 14px;display:flex;align-items:center;gap:12px;background:transparent;border:0;border-radius:8px;color:var(--color_heading);font-size:14px;text-align:left;cursor:pointer}
+.profile_sidebar button:hover{background:#87ceeb29}.profile_sidebar button span{color:var(--color_heading)}.profile_sidebar button svg{flex:none;font-size:19px}.profile_sidebar .profile_logout{margin-top:6px;border-top:1px solid var(--border_color);border-radius:0 0 8px 8px}
+.top_header .search_wrapper{position:relative;width:100%;min-width:0}
+.top_header .search_box{width:100%;height:44px;display:flex;align-items:center;background:#fafafa;border:1px solid var(--border_color);border-radius:24px;overflow:hidden;transition:.2s}
+.top_header .search_box:focus-within{border-color:var(--main_color);box-shadow:0 0 0 3px #87ceeb29}
+.top_header .search_box input{min-width:0;height:100%;flex:1;padding:0 15px;background:transparent;border:0;color:var(--color_heading);font-size:13px}
+.top_header .search_box button{width:44px;height:100%;flex:none;display:grid;place-items:center;background:transparent;border:0;font-size:19px;cursor:pointer}
+.search_results{position:absolute;top:calc(100% + 7px);left:0;width:100%;max-height:300px;padding:7px;background:white;border:1px solid var(--border_color);border-radius:13px;box-shadow:0 14px 35px #0000001f;overflow-y:auto;z-index:2300}
+.search_result_item{width:100%;padding:12px 14px;display:flex;align-items:center;border-radius:9px;color:var(--color_heading);cursor:pointer}.search_result_item:hover{background:#87ceeb29}
+.search_result_item p{margin:0;overflow:hidden;color:var(--color_heading);font-size:14px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
+.top_header .header_icons{display:flex;align-items:center;justify-content:flex-end;gap:9px}
+.top_header .header_icons .icon{position:relative;width:40px;height:40px;flex:none;display:grid;place-items:center;border-radius:50%;color:var(--color_heading)}
+.top_header .header_icons .icon:hover{background:#ffffffb3;color:#4aaed7}.top_header .header_icons .icon svg{font-size:23px}
+.top_header .header_icons .count{position:absolute;top:-2px;right:-2px;min-width:16px;height:16px;padding:0 3px;display:grid;place-items:center;background:var(--main_color);border-radius:20px;color:white;font-size:10px;line-height:1}
+@media(max-width:700px){.top_header .container{width:100%;min-height:auto;padding:10px 12px 12px;grid-template-columns:minmax(0,1fr) auto;gap:9px 10px}.top_header .logo{left:10px;top:-52px;width:42px;height:42px}.profile_btn{width:min(190px,100%);height:38px;padding:0 10px;font-size:12px}.header_profile_image{width:27px;height:27px}.top_header .header_icons .icon{width:34px;height:34px}.top_header .header_icons .icon svg{font-size:20px}.top_header .search_wrapper{grid-column:1/-1;grid-row:2}.top_header .search_box{height:40px}}
+@media(max-width:380px){.top_header .container{padding-inline:8px}.profile_btn{width:min(160px,100%)}.top_header .header_icons{gap:3px}}
