+:root{--main_color:rgb(135,206,235);--bg_color:#f3f3f3;--white_color:#fff;--color_heading:#253237;--color_h1:#112028;--color_h2:#012d3b;--border_color:#d6d6d6d5}
+header{position:relative;display:flex;flex-direction:column}header .btm_header{order:1}header .top_header{order:2}
+.btm_header{position:relative;width:100%;background:var(--main_color);box-shadow:0 4px 15px #0000000d;z-index:500}
+.btm_header .container{width:min(92%,1400px);min-height:64px;margin:auto;padding-left:72px;display:flex;align-items:center;gap:22px;overflow:visible}
+.btm_header .nav{min-width:0;flex:1;display:flex;align-items:center;gap:22px}
+.btm_header .category_nav{position:relative;width:220px;height:46px;flex:0 0 220px;z-index:2500}
+.btm_header .category_btn{width:100%;height:100%;padding:0 15px;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#ffffff33;border:1px solid #ffffff80;border-radius:11px;color:var(--color_h1);cursor:pointer}
+.btm_header .category_btn:hover{background:#ffffff52}.btm_header .category_btn svg{flex:none;font-size:20px}.btm_header .category_btn p{margin:0;overflow:hidden;color:var(--color_h1);font-size:15px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
+.category_nav_list{position:absolute;top:calc(100% + 8px);left:0;width:100%;max-height:360px;padding:5px 0;display:flex;flex-direction:column;background:white;border:1px solid var(--border_color);border-radius:10px;box-shadow:0 15px 35px #00000024;overflow-y:auto;opacity:0;visibility:hidden;transform:translateY(-8px);transition:.22s}
+.category_nav_list.active{opacity:1;visibility:visible;transform:none}.category_nav_list button{width:100%;padding:13px 16px;background:white;border:0;border-bottom:1px solid var(--border_color);color:var(--color_heading);font-size:14px;text-align:left;cursor:pointer}.category_nav_list button:last-child{border-bottom:0}.category_nav_list button:hover{padding-left:21px;background:var(--bg_color);color:var(--color_h2)}
+.btm_header .nav_links{min-width:0;display:flex;align-items:center;justify-content:center;gap:6px;margin:0;padding:0;list-style:none}.btm_header .nav_links li{height:42px;flex:none;display:flex;align-items:center;border-radius:9px}.btm_header .nav_links li a{height:100%;padding:0 17px;display:grid;place-items:center;border-radius:inherit;color:var(--color_h1);font-size:14px;font-weight:500;white-space:nowrap}.btm_header .nav_links li:hover{background:#ffffff40}.btm_header .nav_links li.active{background:white;box-shadow:0 3px 10px #00000014}
+.btm_header .logout_btn{margin-left:auto;padding:9px 14px;flex:none;display:flex;align-items:center;gap:7px;background:#ffffff33;border:1px solid #ffffff8c;border-radius:10px;color:#000;font-size:13px;font-weight:600;cursor:pointer}.btm_header .logout_btn:hover{background:white}.btm_header .logout_btn span,.btm_header .logout_btn svg{color:#000}.btm_header .logout_btn svg{font-size:19px}
+@media(max-width:900px){.btm_header .container{width:96%;gap:10px;padding-left:58px}.btm_header .nav{gap:10px}.btm_header .category_nav{width:190px;flex-basis:190px}.btm_header .nav_links li a{padding:0 10px;font-size:13px}.btm_header .logout_btn{padding-inline:10px}}
+@media(max-width:700px){.btm_header .container{width:100%;min-height:auto;padding:8px 10px 8px 60px;align-items:flex-start;gap:8px}.btm_header .nav{display:grid;grid-template-columns:minmax(130px,1fr);gap:6px}.btm_header .category_nav{width:min(240px,100%);height:40px;flex-basis:auto}.btm_header .category_btn{padding-inline:11px}.btm_header .category_btn p{font-size:13px}.btm_header .nav_links{grid-row:2;justify-content:flex-start;gap:2px}.btm_header .nav_links li{height:34px}.btm_header .nav_links li a{padding:0 10px;font-size:12px}.btm_header .logout_btn{height:40px;padding:0 10px}.btm_header .logout_btn span{display:none}}
+@media(max-width:390px){.btm_header .container{padding-left:52px;padding-right:7px}.btm_header .nav_links li a{padding-inline:7px;font-size:11px}.btm_header .logout_btn{width:36px;padding:0;justify-content:center}}
