-  color: var(--color_heading);
-  font-size: 14px;
-  font-weight: 500;
-  text-decoration: none;
-  border-bottom: 1px solid var(--border_color);
-  transition: all 0.25s ease;
-}
-
-.btm_header .category_nav .category_nav_list a:first-child {
