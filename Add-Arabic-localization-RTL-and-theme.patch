diff --git a/index.html b/index.html
index 5bd6cf1..5885bd4 100644
--- a/index.html
+++ b/index.html
@@ -2,6 +2,20 @@
 <html lang="en">
   <head>
     <meta charset="UTF-8" />
+    <script>
+      (() => {
+        let theme = 'system', language = 'en';
+        try {
+          theme = localStorage.getItem('store.theme') || 'system';
+          language = localStorage.getItem('store.language') === 'ar' ? 'ar' : 'en';
+        } catch {}
+        const dark = theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
+        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
+        document.documentElement.lang = language;
+        document.documentElement.dir = language === 'ar' ? 'rtl' : 'ltr';
+      })();
+    </script>
     <link rel="icon" type="image/svg+xml" href="/src/img/logo.jpg" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>ecommerce</title>
